<Window x:Class="CS2PerformanceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CS2 Performance Manager" Icon="App.ico" Width="730" Height="510"
        MinWidth="460" MinHeight="340" WindowStartupLocation="CenterScreen"
        Background="#101011" Foreground="#F6F3EF" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#302626" />
            <Setter Property="Foreground" Value="#F6F3EF" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value=".8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tile" TargetType="ToggleButton">
            <Setter Property="Background" Value="#2E2526" />
            <Setter Property="Foreground" Value="#D3CFCC" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="TileBorder" BorderBrush="#56403B" BorderThickness="1"
                                Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#FF9749" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="#62381F" />
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#F88A39" />
                                <Setter Property="Foreground" Value="#FFD6B8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TileBorder" Property="Opacity" Value=".40" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource Tile}">
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite" Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Left">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderSurface" Background="Transparent" CornerRadius="6" Padding="5,7">
                                            <DockPanel>
                                                <Path x:Name="Chevron" Data="M 0,0 L 4,4 L 8,0" Stroke="#DAA88E"
                                                      StrokeThickness="1.4" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                                      RenderTransformOrigin=".5,.5" VerticalAlignment="Center" Margin="1,0,9,0"/>
                                                <ContentPresenter RecognizesAccessKey="True"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderSurface" Property="Background" Value="#14FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="5,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E7E2DE" />
        </Style>
    </Window.Resources>
    <Grid ClipToBounds="True">
        <Grid.Background>
            <RadialGradientBrush Center=".91,0" GradientOrigin=".91,0" RadiusX=".95" RadiusY="1.35">
                <GradientStop Color="#37312F" Offset="0"/>
                <GradientStop Color="#242325" Offset=".42"/>
                <GradientStop Color="#16171B" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid Margin="29,23,29,22">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="UiScale"/>
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,22">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button x:Name="ZoomOut" Content="−" Click="ZoomOut_Click" AutomationProperties.Name="Zmniejsz interfejs"
                                Padding="7,4"/>
                        <Button x:Name="ZoomReset" Content="100%" Click="ZoomReset_Click" ToolTip="Przywróć skalę 100%"
                                AutomationProperties.Name="Przywróć skalę 100%" Padding="7,4" Margin="3,0"/>
                        <Button x:Name="ZoomIn" Content="+" Click="ZoomIn_Click" AutomationProperties.Name="Powiększ interfejs"
                                Padding="7,4"/>
                    </StackPanel>
                    <TextBlock x:Name="CpuName" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          VerticalAlignment="Center">
                <StackPanel>
                <StackPanel>
                    <TextBlock Text="Wątki dla CS2" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="UnchangedOption" GroupName="Profile" Content="Windows" Checked="Profile_Checked"/>
                        <RadioButton x:Name="CustomOption" GroupName="Profile" Content="Ręcznie" Checked="Profile_Checked" Click="OpenMap_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="SavedSelection" Foreground="#E1CEC3" Margin="0,7,0,12"/>
                    <Expander x:Name="AdvancedPanel" Header="Profile CCD i priorytet" Foreground="#F3E7E0" Margin="0,5,0,0"
                              Expanded="Section_Expanded">
                        <StackPanel Margin="0,13,0,0">
                            <WrapPanel>
                                <RadioButton x:Name="Ccd0NoSmt" GroupName="Profile" Checked="Profile_Checked" Click="OpenMap_Click"/>
                                <RadioButton x:Name="Ccd0WithSmt" GroupName="Profile" Checked="Profile_Checked" Click="OpenMap_Click"/>
                                <RadioButton x:Name="Ccd1NoSmt" GroupName="Profile" Checked="Profile_Checked" Click="OpenMap_Click"/>
                                <RadioButton x:Name="Ccd1WithSmt" GroupName="Profile" Checked="Profile_Checked" Click="OpenMap_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="TopologyNote" Foreground="#C8B5AC" Margin="0,0,0,12"/>
                            <TextBlock Text="Priorytet gry" FontWeight="SemiBold" Margin="0,12,0,9"/>
                            <WrapPanel>
                                <RadioButton x:Name="NormalPriority" GroupName="Priority" Content="Normal" IsChecked="True"/>
                                <RadioButton x:Name="AbovePriority" GroupName="Priority" Content="Above Normal"/>
                                <RadioButton x:Name="HighPriority" GroupName="Priority" Content="High"/>
                            </WrapPanel>
                            <CheckBox x:Name="StartupOption" Content="Uruchamiaj po zalogowaniu" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <Separator Background="#2ADBC1B2" Margin="0,16,0,16" />
                <Expander x:Name="MapPanel" Header="Mapa procesora" Foreground="#F3E7E0" Expanded="Section_Expanded">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock x:Name="CpuSummary" Foreground="#D7C4BA"/>
                        <TextBlock x:Name="SelectionSummary" Foreground="#FFB68A" Margin="0,3,0,8"/>
                        <Button x:Name="OneThreadButton" Content="Jeden wątek na rdzeń" HorizontalAlignment="Left"
                                Click="OneThread_Click" Margin="0,0,0,10"/>
                        <StackPanel x:Name="CpuGroups"/>
                    </StackPanel>
                </Expander>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <Separator Background="#2ADBC1B2" />
                <DockPanel LastChildFill="True" Margin="0,14,0,0">
                    <Button DockPanel.Dock="Right" Click="Save_Click" ToolTip="Zapisz i zastosuj"
                            AutomationProperties.Name="Zapisz i zastosuj" VerticalAlignment="Center"
                            Width="42" Height="42" Margin="14,0,0,0" Background="#FFBA8C" Foreground="#24120A">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ApplySurface" CornerRadius="21" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ApplySurface" Property="Background" Value="#FFD0B0"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ApplySurface" Property="Opacity" Value=".8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Width="20" Height="20" Stretch="Uniform" Stroke="#24120A" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Data="M 17,6 A 7,7 0 1 0 18,13 M 17,2 L 17,7 L 12,7"/>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="STAN CS2" Foreground="#FFB68A" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="GameStatus" Foreground="#E8D8D0"/>
                        <TextBlock x:Name="Feedback" Foreground="#FFB68A"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
