<Window x:Class="CS2PerformanceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CS2 Performance Manager" Icon="App.ico" Width="860" Height="590"
        MinWidth="460" MinHeight="340" WindowStartupLocation="CenterScreen"
        Background="#101011" Foreground="#F6F3EF" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <EventSetter Event="MouseEnter" Handler="Interactive_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="Interactive_MouseLeave"/>
            <Setter Property="Background" Value="#2C2D33" />
            <Setter Property="Foreground" Value="#F6F3EF" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value=".8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tile" TargetType="ToggleButton">
            <EventSetter Event="MouseEnter" Handler="Interactive_MouseEnter"/>
            <EventSetter Event="MouseLeave" Handler="Interactive_MouseLeave"/>
            <Setter Property="Background" Value="#2B2C32" />
            <Setter Property="Foreground" Value="#D3CFCC" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="TileBorder" BorderBrush="#45464E" BorderThickness="1"
                                Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#FF9749" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="#62381F" />
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#F88A39" />
                                <Setter Property="Foreground" Value="#FFD6B8" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Preset">
                                <Setter TargetName="TileBorder" Property="Background" Value="#62381F" />
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#F88A39" />
                                <Setter Property="Foreground" Value="#FFD6B8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TileBorder" Property="Opacity" Value=".40" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource Tile}">
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite" Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Left">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderSurface" Background="Transparent" CornerRadius="6" Padding="5,7">
                                            <DockPanel>
                                                <Path x:Name="Chevron" Data="M 0,0 L 4,4 L 8,0" Stroke="#DAA88E"
                                                      StrokeThickness="1.4" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                                      RenderTransformOrigin=".5,.5" VerticalAlignment="Center" Margin="1,0,9,0"/>
                                                <ContentPresenter RecognizesAccessKey="True"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderSurface" Property="Background" Value="#14FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="5,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E7E2DE"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel Background="Transparent">
                            <Border x:Name="SwitchTrack" Width="32" Height="18" CornerRadius="9" Background="#48464B"
                                    VerticalAlignment="Center" Margin="0,0,9,0" Padding="3">
                                <Ellipse x:Name="SwitchKnob" Width="12" Height="12" Fill="#F0E5DE" HorizontalAlignment="Left"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#FFBA8C"/>
                                <Setter TargetName="SwitchKnob" Property="Fill" Value="#30211B"/>
                                <Setter TargetName="SwitchKnob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value=".82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchTrack" Property="Opacity" Value=".4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinHeight="28">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ScrollGrip" CornerRadius="4" Margin="3,1" Background="#696269"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ScrollGrip" Property="Background" Value="#AB8E83"/>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ScrollGrip" Property="Background" Value="#FFBA8C"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid ClipToBounds="True">
        <Grid.Background>
            <RadialGradientBrush Center=".91,0" GradientOrigin=".91,0" RadiusX=".95" RadiusY="1.35">
                <GradientStop Color="#323338" Offset="0"/>
                <GradientStop Color="#232429" Offset=".42"/>
                <GradientStop Color="#18191D" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid Margin="29,23,29,22">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="UiScale"/>
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,22">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button x:Name="ZoomOut" Content="−" Click="ZoomOut_Click" AutomationProperties.Name="Zmniejsz interfejs"
                                Padding="7,4"/>
                        <Button x:Name="ZoomReset" Content="100%" Click="ZoomReset_Click" ToolTip="Przywróć skalę 100%"
                                AutomationProperties.Name="Przywróć skalę 100%" Padding="7,4" Margin="3,0"/>
                        <Button x:Name="ZoomIn" Content="+" Click="ZoomIn_Click" AutomationProperties.Name="Powiększ interfejs"
                                Padding="7,4"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="CpuName" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="GameStatus" Foreground="#C4C5CF" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="970">
                    <Separator Background="#38393F" Margin="0,0,0,20"/>
                    <Grid x:Name="ProfileStage" SizeChanged="ProfileStage_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="6*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="ProfileFocus" Margin="0,7,0,0" VerticalAlignment="Top">
                            <TextBlock x:Name="FocusCaption" Text="ZAPISANY PROFIL" Foreground="#BFC0C8" FontSize="11"/>
                            <TextBlock x:Name="FocusProfile" FontSize="41" FontWeight="SemiBold" Foreground="#FFBE98" Margin="0,5,0,3"/>
                            <TextBlock x:Name="FocusDetail" Foreground="#CACBD4" FontSize="14"/>
                            <StackPanel Margin="0,16,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="UnchangedOption" GroupName="Profile" Content="Windows"
                                                     ToolTip="Windows dobiera wątki dla CS2" Checked="Profile_Checked" Margin="0,0,15,6"/>
                                        <RadioButton x:Name="CustomOption" GroupName="Profile" Content="Ręcznie"
                                                     ToolTip="Wybierz profil lub zaznacz wątki na mapie"
                                                     Checked="Profile_Checked" Click="OpenMap_Click"/>
                                    </StackPanel>
                                    <StackPanel x:Name="ManualProfiles" Visibility="Collapsed" Margin="0,10,0,0">
                                        <TextBlock x:Name="ManualProfileTitle" Text="Gotowe profile" Foreground="#E5B39A"
                                                   FontWeight="SemiBold" Margin="0,0,0,7"/>
                                        <WrapPanel>
                                            <RadioButton x:Name="Ccd0NoSmt" GroupName="Profile" Checked="Profile_Checked" Click="OpenMap_Click"/>
                                            <RadioButton x:Name="Ccd0WithSmt" GroupName="Profile" Checked="Profile_Checked" Click="OpenMap_Click"/>
                                            <RadioButton x:Name="Ccd1NoSmt" GroupName="Profile" Checked="Profile_Checked" Click="OpenMap_Click"/>
                                            <RadioButton x:Name="Ccd1WithSmt" GroupName="Profile" Checked="Profile_Checked" Click="OpenMap_Click"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="TopologyNote" Foreground="#C8B5AC" Margin="0,0,0,8"/>
                                    </StackPanel>
                            </StackPanel>
                            <Separator Background="#38393F" Margin="0,14,0,10"/>
                            <Expander x:Name="AdvancedPanel" Header="Ustawienia gry" Foreground="#E0E0E7" Expanded="Section_Expanded">
                                <StackPanel Margin="0,4,0,12">
                                    <TextBlock Text="Priorytet gry" FontWeight="SemiBold" Margin="0,12,0,9"/>
                                    <WrapPanel>
                                        <RadioButton x:Name="NormalPriority" GroupName="Priority" Checked="SettingsChanged" Content="Normal" IsChecked="True"/>
                                        <RadioButton x:Name="AbovePriority" GroupName="Priority" Checked="SettingsChanged" Content="Above Normal"/>
                                        <RadioButton x:Name="HighPriority" GroupName="Priority" Checked="SettingsChanged" Content="High"/>
                                    </WrapPanel>
                                    <CheckBox x:Name="StartupOption" Checked="SettingsChanged" Unchecked="SettingsChanged" Content="Uruchamiaj po zalogowaniu" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        <Expander x:Name="MapPanel" Grid.Column="1" VerticalAlignment="Top" Margin="20,0,0,0" Header="Mapa procesora" Foreground="#F3E7E0" Expanded="Section_Expanded">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock x:Name="CpuSummary" Foreground="#D7C4BA"/>
                                <TextBlock x:Name="SelectionSummary" Foreground="#CBCBD3" Margin="0,3,0,8"/>
                                <Button x:Name="OneThreadButton" Content="Jeden wątek na rdzeń" HorizontalAlignment="Left"
                                        Click="OneThread_Click" Margin="0,0,0,10"/>
                                <StackPanel x:Name="CpuGroups"/>
                            </StackPanel>
                        </Expander>
                    </Grid>
                    <StackPanel Margin="0,20,0,0">
                        <Separator Background="#2ADBC1B2" />
                        <DockPanel LastChildFill="True" Margin="0,14,0,0">
                            <Button x:Name="SaveButton" Visibility="Hidden" DockPanel.Dock="Right" Click="Save_Click" ToolTip="Zapisz i zastosuj"
                                    AutomationProperties.Name="Zapisz i zastosuj" VerticalAlignment="Center"
                                    Width="42" Height="42" Margin="14,0,0,0" Background="#FFBA8C" Foreground="#24120A">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ApplySurface" CornerRadius="21" Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ApplySurface" Property="Background" Value="#FFD0B0"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="ApplySurface" Property="Opacity" Value=".8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Path Width="20" Height="20" Stretch="Uniform" Stroke="#24120A" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 4,11 L 9,16 L 19,6"/>
                            </Button>
                            <StackPanel>
                                <TextBlock x:Name="FooterCaption" Text="ZAPISANE DLA CS2" Foreground="#BFC0C8" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SavedSelection" Foreground="#E0E0E7"/>
                                <TextBlock x:Name="Feedback" Foreground="#FFB68A"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>





