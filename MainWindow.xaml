<Window x:Class="CS2PerformanceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CS2 Performance Manager" Icon="App.ico" Width="900" Height="710"
        MinWidth="740" MinHeight="510" WindowStartupLocation="CenterScreen"
        Background="#101011" Foreground="#F6F3EF" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#19191B" />
            <Setter Property="BorderBrush" Value="#303033" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#29292C" />
            <Setter Property="Foreground" Value="#F6F3EF" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value=".8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tile" TargetType="ToggleButton">
            <Setter Property="Background" Value="#242427" />
            <Setter Property="Foreground" Value="#D3CFCC" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="TileBorder" BorderBrush="#38383B" BorderThickness="1"
                                Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#FF9749" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="#4A2A19" />
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#F88A39" />
                                <Setter Property="Foreground" Value="#FFD6B8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TileBorder" Property="Opacity" Value=".40" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource Tile}">
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E7E2DE" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="24,18,24,18">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Image Source="App.ico" Width="46" Height="46" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="CS2 PERFORMANCE MANAGER" FontSize="11" FontWeight="Bold" Foreground="#FF9A53" />
                <TextBlock x:Name="CpuName" FontSize="24" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="STAN CS2" FontSize="10" FontWeight="Bold" Foreground="#FF9A53" />
                <TextBlock x:Name="GameStatus" Foreground="#D0C9C3" MaxHeight="48" />
                <TextBlock x:Name="Feedback" Foreground="#FFB481" MaxHeight="48" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Zastosuj ponownie" Click="Retry_Click" Margin="0,0,8,0" />
                <Button Content="Zapisz i zastosuj" Click="Save_Click" Background="#FF933F"
                        Foreground="#17100A" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="272" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="Topologia procesora" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock x:Name="CpuSummary" Foreground="#AFA9A5" Margin="0,3,0,0" />
                        <TextBlock x:Name="SelectionSummary" Foreground="#FFAC71" Margin="0,8,0,0" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="CpuGroups" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Profile CPU" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Profil zaznacza wątki na mapie. Kliknięcie wątku przełącza na wybór ręczny."
                                   Foreground="#AFA9A5" Margin="0,4,0,13" />
                        <TextBlock Text="CCD0" FontSize="11" Foreground="#FF9A53" FontWeight="Bold" Margin="0,0,0,5" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="Ccd0NoSmt" GroupName="Profile" Content="− SMT" Checked="Profile_Checked" />
                            <RadioButton x:Name="Ccd0WithSmt" GroupName="Profile" Content="+ SMT" Checked="Profile_Checked" />
                        </StackPanel>
                        <TextBlock Text="CCD1" FontSize="11" Foreground="#FF9A53" FontWeight="Bold" Margin="0,6,0,5" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="Ccd1NoSmt" GroupName="Profile" Content="− SMT" Checked="Profile_Checked" />
                            <RadioButton x:Name="Ccd1WithSmt" GroupName="Profile" Content="+ SMT" Checked="Profile_Checked" />
                        </StackPanel>
                        <WrapPanel Margin="0,9,0,0">
                            <RadioButton x:Name="CustomOption" GroupName="Profile" Content="Ręcznie" Checked="Profile_Checked" />
                            <RadioButton x:Name="UnchangedOption" GroupName="Profile" Content="Bez zmian" Checked="Profile_Checked" />
                        </WrapPanel>
                        <TextBlock x:Name="TopologyNote" Foreground="#AFA9A5" FontSize="12" Margin="0,3,0,0" />
                        <Border Height="1" Background="#38383B" Margin="0,17,0,15" />
                        <TextBlock Text="Priorytet gry" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel>
                            <RadioButton x:Name="NormalPriority" GroupName="Priority" Content="Normal" IsChecked="True" />
                            <RadioButton x:Name="AbovePriority" GroupName="Priority" Content="Above Normal" />
                            <RadioButton x:Name="HighPriority" GroupName="Priority" Content="High" />
                        </WrapPanel>
                        <CheckBox x:Name="StartupOption" Margin="0,12,0,0">
                            <TextBlock Text="Uruchamiaj po zalogowaniu" />
                        </CheckBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
