<Window x:Class="CS2PerformanceManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CS2 Performance Manager" Icon="App.ico" Width="730" SizeToContent="Height" MaxHeight="790"
        MinWidth="460" MinHeight="300" WindowStartupLocation="CenterScreen"
        Background="#101011" Foreground="#F6F3EF" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#302626" />
            <Setter Property="Foreground" Value="#F6F3EF" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value=".8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Tile" TargetType="ToggleButton">
            <Setter Property="Background" Value="#2E2526" />
            <Setter Property="Foreground" Value="#D3CFCC" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="TileBorder" BorderBrush="#56403B" BorderThickness="1"
                                Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#FF9749" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="#62381F" />
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#F88A39" />
                                <Setter Property="Foreground" Value="#FFD6B8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TileBorder" Property="Opacity" Value=".40" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource Tile}">
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite" Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Left">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderSurface" Background="Transparent" CornerRadius="6" Padding="5,7">
                                            <DockPanel>
                                                <Path x:Name="Chevron" Data="M 0,0 L 4,4 L 8,0" Stroke="#DAA88E"
                                                      StrokeThickness="1.4" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                                      RenderTransformOrigin=".5,.5" VerticalAlignment="Center" Margin="1,0,9,0"/>
                                                <ContentPresenter RecognizesAccessKey="True"/>
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderSurface" Property="Background" Value="#14FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="5,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E7E2DE" />
        </Style>
    </Window.Resources>
    <Grid ClipToBounds="True">
        <Grid.Background>
            <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                <GradientStop Color="#352823" Offset="0"/>
                <GradientStop Color="#201B1C" Offset=".46"/>
                <GradientStop Color="#111113" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Viewbox HorizontalAlignment="Right" VerticalAlignment="Top" Width="535"
                 Opacity=".12" IsHitTestVisible="False" Margin="0,-13,-30,0">
            <Canvas Width="560" Height="290">
                <Path Stroke="#D38C69" StrokeThickness="2.5" StrokeLineJoin="Round"
                      Data="M 18,112 L 59,112 59,75 148,75 148,44 215,44 215,83 363,83 363,49 507,49 507,142 466,142 466,201 380,201 380,257 240,257 240,215 120,215 120,178 56,178 56,147 18,147 Z M 59,112 L 174,112 174,154 312,154 312,109 466,109 466,142 M 120,178 L 174,178 174,154 M 240,215 L 275,215 275,154 M 312,154 L 380,154 380,201"/>
                <Ellipse Width="43" Height="43" Canvas.Left="421" Canvas.Top="62" Stroke="#FFB587" StrokeThickness="2"/>
                <TextBlock Text="A" Canvas.Left="435" Canvas.Top="67" FontSize="21" Foreground="#FFE0B9"/>
                <Ellipse Width="43" Height="43" Canvas.Left="94" Canvas.Top="94" Stroke="#FFB587" StrokeThickness="2"/>
                <TextBlock Text="B" Canvas.Left="108" Canvas.Top="99" FontSize="21" Foreground="#FFE0B9"/>
            </Canvas>
        </Viewbox>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="25,18,25,20">
                <StackPanel.LayoutTransform>
                    <ScaleTransform x:Name="UiScale"/>
                </StackPanel.LayoutTransform>
                <DockPanel Margin="0,0,0,18">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button x:Name="ZoomOut" Content="−" Click="ZoomOut_Click" AutomationProperties.Name="Zmniejsz interfejs"
                                Padding="7,4"/>
                        <Button x:Name="ZoomReset" Content="100%" Click="ZoomReset_Click" ToolTip="Przywróć skalę 100%"
                                AutomationProperties.Name="Przywróć skalę 100%" Padding="7,4" Margin="3,0"/>
                        <Button x:Name="ZoomIn" Content="+" Click="ZoomIn_Click" AutomationProperties.Name="Powiększ interfejs"
                                Padding="7,4"/>
                    </StackPanel>
                    <TextBlock x:Name="CpuName" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel>
                    <TextBlock Text="Wątki dla CS2" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="UnchangedOption" GroupName="Profile" Content="Windows" Checked="Profile_Checked"/>
                        <RadioButton x:Name="CustomOption" GroupName="Profile" Content="Ręcznie" Checked="Profile_Checked" Click="OpenMap_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="SavedSelection" Foreground="#E1CEC3" Margin="0,3,0,6"/>
                    <Expander x:Name="AdvancedPanel" Header="Profile CCD i priorytet" Foreground="#F3E7E0" Margin="0,5,0,0"
                              Expanded="Section_Expanded">
                        <StackPanel Margin="0,9,0,0">
                            <WrapPanel>
                                <RadioButton x:Name="Ccd0NoSmt" GroupName="Profile" Checked="Profile_Checked" Click="OpenMap_Click"/>
                                <RadioButton x:Name="Ccd0WithSmt" GroupName="Profile" Checked="Profile_Checked" Click="OpenMap_Click"/>
                                <RadioButton x:Name="Ccd1NoSmt" GroupName="Profile" Checked="Profile_Checked" Click="OpenMap_Click"/>
                                <RadioButton x:Name="Ccd1WithSmt" GroupName="Profile" Checked="Profile_Checked" Click="OpenMap_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="TopologyNote" Foreground="#C8B5AC" Margin="0,0,0,8"/>
                            <TextBlock Text="Priorytet gry" FontWeight="SemiBold" Margin="0,4,0,6"/>
                            <WrapPanel>
                                <RadioButton x:Name="NormalPriority" GroupName="Priority" Content="Normal" IsChecked="True"/>
                                <RadioButton x:Name="AbovePriority" GroupName="Priority" Content="Above Normal"/>
                                <RadioButton x:Name="HighPriority" GroupName="Priority" Content="High"/>
                            </WrapPanel>
                            <CheckBox x:Name="StartupOption" Content="Uruchamiaj po zalogowaniu" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <Separator Background="#2ADBC1B2" Margin="0,12,0,12" />
                <Expander x:Name="MapPanel" Header="Mapa procesora" Foreground="#F3E7E0" Expanded="Section_Expanded">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock x:Name="CpuSummary" Foreground="#D7C4BA"/>
                        <TextBlock x:Name="SelectionSummary" Foreground="#FFB68A" Margin="0,3,0,8"/>
                        <Button x:Name="OneThreadButton" Content="Jeden wątek na rdzeń" HorizontalAlignment="Left"
                                Click="OneThread_Click" Margin="0,0,0,10"/>
                        <StackPanel x:Name="CpuGroups"/>
                    </StackPanel>
                </Expander>
                <Separator Background="#2ADBC1B2" Margin="0,12,0,12" />
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Zapisz i zastosuj" Click="Save_Click"
                            Background="#FFBA8C" Foreground="#24120A" FontWeight="SemiBold"
                            VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <StackPanel>
                        <TextBlock Text="STAN CS2" Foreground="#FFB68A" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="GameStatus" Foreground="#E8D8D0"/>
                        <TextBlock x:Name="Feedback" Foreground="#FFB68A"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>




